// engine/core/bbLocalMessageInputs.c

bbFlag bbLocalMessage_NetpauseButton(bbCore* core, char* key)
{
    bbLocalMessage* message;
    bbThreadedQueue_alloc(&core->local_message_queue, (void** ) &message);
    message->type = bbLocalMessage_netpauseButton;

    bbStr_setStr(message->data.key, key, KEY_LENGTH);

    bbThreadedQueue_pushL(&core->local_message_queue, message);
    return bbSuccess;
}


// engine/core/bbLocalMessage.c
case bbLocalMessage_netpauseButton:
bbLocalMessage_netpauseButton_fn(core, message);
bbCore_react(core);

// engine/core/bbLocalMessage.c
bbFlag bbLocalMessage_netpauseButton_fn(bbCore* core, bbLocalMessage* message)
{
    bbCoreInput_netpauseButton(core,message->data.key);

    return bbSuccess;
}

// engine/core/bbCoreInputs.c
bbFlag bbCoreInput_netpauseButton(bbCore* core, char* string)
{
    bbInstruction* instruction;
    bbList_alloc(&core->do_stack, (void**) &instruction);

    instruction->type = bbInstruction_netpauseButton;
    bbStr_setStr(instruction->data.key, string, KEY_LENGTH);

    bbList_pushL(&core->do_stack, instruction);

    return bbSuccess;
}

// engine/core/bbCore.c
case bbInstruction_netpauseButton:
bbInstruction_netpauseButton_fn(core, instruction);
break;

// engine/core/bbInstruction.c
bbFlag bbInstruction_netpauseButton_fn(bbCore* core, bbInstruction* instruction)
{
    bbNetworkApp_netpauseButton(&home.network, instruction->data.key);
    return bbSuccess;
}

// engine/network/bbNetworkApp.c
if (packet->type == PACKETTYPE_PAUSE)
{
    bbClock_setPause(&home.clock2,
                       packet->data.pause.reference_server_tick,
                      packet->data.pause.reference_map_tick,
                      packet->data.pause.is_paused);
    bbLocalMessage_UnfreezeButton(&home.core.core,"(UN)PAUSE");
}